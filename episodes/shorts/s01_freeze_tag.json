      "set": "playground",
      "cast": {"noob": [-8, 0, 0], "bacon": [-4, 0, 0], "sage": [0, 0, 0], "goldie": [4, 0, 0], "nova": [8, 0, 0]},
      "shots": [
        {"_beat": "HOOK", "speaker": "sage", "vo": true, "line": "My best friend got tagged... and turned into a statue.",
         "cameras": ["medium:noob", "extreme:noob@-10"], "move": "push", "sfx": "freeze",
         "anims": {"noob": "frozen", "sage": "shocked"}, "faces": {"noob": "shocked", "sage": "shocked"}},

        {"_beat": "FLIP", "speaker": "sage", "vo": true, "line": "The new girl, Nova, had one rule.",
         "camera": "wide", "move": "push", "anims": {"noob": "frozen"}, "faces": {"noob": "shocked", "nova": "smug"}},

        {"speaker": "nova", "line": "Tag means freeze.", "face": "evil", "camera": "low:nova@-8", "move": "zoom",
         "sfx": "vine_boom", "anims": {"noob": "frozen", "nova": "point"}, "faces": {"noob": "shocked"}},

        {"speaker": "sage", "vo": true, "line": "And the only way out was to tell a secret you've never told anyone.",
         "cameras": ["closeup:nova", "ots:goldie,nova"], "anims": {"noob": "frozen"},
         "faces": {"noob": "shocked", "nova": "smug", "sage": "scared"}},

        {"_beat": "PROOF 1", "speaker": "noob", "line": "I still sleep with a night light!", "face": "scared",
         "camera": "closeup:noob", "anims": {"noob": "unfreeze"}, "sfx": "pop"},

        {"speaker": "sage", "vo": true, "line": "Bacon laughed so hard...", "camera": "medium:bacon",
         "anims": {"bacon": "laugh"}, "faces": {"bacon": "happy"}},

        {"speaker": "bacon", "line": "Bro.", "face": "smug", "camera": "closeup:bacon", "anims": {"bacon": "laugh"}},

        {"speaker": "sage", "vo": true, "line": "...that Nova tagged him next.", "camera": "medium:bacon@8", "move": "shake",
         "sfx": "freeze", "anims": {"bacon": "frozen", "nova": "point"}, "faces": {"bacon": "shocked", "nova": "evil"}},

        {"speaker": "bacon", "line": "Fine! I cried at a dog food commercial. TWICE.", "face": "cry",
         "camera": "closeup:bacon", "anims": {"bacon": "unfreeze"}, "faces": {"noob": "happy"}, "sfx": "sad_trombone"},

        {"_beat": "TURN", "speaker": "sage", "vo": true, "line": "It was funny. Until it wasn't.",
         "camera": "two:goldie,nova", "move": "push", "anims": {"nova": "point"},
         "faces": {"nova": "evil", "goldie": "smug"}},

        {"speaker": "sage", "vo": true, "line": "Goldie, the richest kid in school, froze mid-brag.",
         "cameras": ["medium:goldie", "extreme:goldie@10"], "sfx": "freeze",
         "anims": {"goldie": "frozen"}, "faces": {"goldie": "shocked"}},

        {"speaker": "goldie", "line": "I pay people to be my friends.", "face": "sad", "camera": "closeup:goldie",
         "anims": {"goldie": "unfreeze"}, "faces": {"sage": "sad", "bacon": "sad", "noob": "sad"}, "hold": 0.3},

        {"speaker": "sage", "vo": true, "line": "Nobody laughed this time.", "camera": "wide", "move": "pull",
         "anims": {"goldie": "sad"}, "faces": {"goldie": "sad", "sage": "sad", "bacon": "sad", "noob": "sad"}},

        {"_beat": "THE HERO", "speaker": "sage", "vo": true, "line": "Then Nova looked at me.",
         "camera": "closeup:nova@-7", "anims": {"nova": "point"}, "faces": {"nova": "evil"}, "sfx": "heartbeat"},

        {"duration": 0.9, "camera": "extreme:sage", "move": "zoom", "sfx": "freeze",
         "anims": {"sage": "frozen"}, "faces": {"sage": "scared"}},

        {"speaker": "sage", "line": "I only smile... so nobody leaves me.", "face": "cry", "camera": "closeup:sage",
         "move": "push", "anims": {"sage": "unfreeze"}, "hold": 0.4},

        {"speaker": "sage", "vo": true, "line": "But as I broke free, I noticed something.", "camera": "closeup:nova",
         "move": "push", "faces": {"nova": "sad"}, "sfx": "riser"},

        {"speaker": "sage", "line": "Nova... who tagged YOU?", "face": "sus", "camera": "two:sage,nova",
         "anims": {"sage": "point"}},

        {"_beat": "PUNCH", "speaker": "nova", "line": "Nobody. I've been It for ten years.", "face": "cry",
         "camera": "closeup:nova", "move": "push", "anims": {"nova": "sad"}, "faces": {"sage": "sad"}, "hold": 0.3},

        {"speaker": "sage", "vo": true, "line": "She wasn't the villain. She was the loneliest kid on the playground.",
         "cameras": ["wide", "medium:nova"], "move": "pull", "anims": {"nova": "sad"},
         "faces": {"nova": "cry", "sage": "sad", "noob": "sad", "bacon": "sad", "goldie": "sad"}},

        {"speaker": "sage", "line": "Tag. You're free.", "face": "happy", "camera": "two:sage,nova",
         "anims": {"sage": "point", "nova": "shocked"}, "faces": {"nova": "shocked"}, "sfx": "sparkle"},

        {"speaker": "nova", "line": "...Nobody's ever tagged me back before.", "face": "happy", "camera": "closeup:nova",
         "move": "push", "faces": {"sage": "happy"}, "hold": 0.4},

        {"speaker": "sage", "vo": true, "line": "We played until the streetlights came on.", "camera": "wide",
         "move": "pull", "anims": {"nova": "jump", "noob": "dance", "bacon": "dance", "goldie": "jump", "sage": "dance"},
         "faces": {"nova": "happy", "noob": "happy", "bacon": "happy", "goldie": "happy", "sage": "happy"}},

        {"_beat": "OUT (loops)", "speaker": "nova", "line": "Thanks! ...Noob, you're It.", "face": "evil",
         "cameras": ["closeup:nova", "medium:noob"], "anims": {"nova": "point", "noob": "frozen"},
         "faces": {"noob": "shocked"}, "sfx": "freeze", "hold": 0.5}
      ]
    }
  ]
